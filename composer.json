  "require": {
    "php": "^8.3",
    "ozitag/tager-backend-core": "^2.0",
    "ozitag/tager-backend-rbac": "^2.0",
    "ozitag/tager-backend-crud": "^2.0",
    "sendpulse/rest-api": "^1.0",
    "symfony/http-client": "^8.0",
    "symfony/mailgun-mailer": "^8.0",
    "symfony/sendgrid-mailer": "^8.0",
    "symfony/brevo-mailer": "^8.0",
    "symfony/mailchimp-mailer": "^8.0"
  },
  "autoload": {
    "psr-4": {
      "OZiTAG\\Tager\\Backend\\Mail\\": "src"
    }
  },
  "config": {
    "allow-plugins": {
